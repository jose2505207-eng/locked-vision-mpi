# Copy to .env and fill in only the integrations you use. All are optional —
# the core demo runs with none of these set.

# Frontend -> backend URL
VITE_API_URL=http://localhost:8000

# Sentry (Best Use of Sentry)
SENTRY_DSN=

# Redis (Best Use of Redis)
REDIS_URL=redis://localhost:6379/0

# Deepgram (Best Use of Deepgram)
DEEPGRAM_API_KEY=

# Arize (Best Use of Arize)
ARIZE_API_KEY=
ARIZE_SPACE_ID=

# Fetch agent -> backend URL
MES_BACKEND_URL=http://localhost:8000

# Anthropic / Claude (audit-log explanations)
ANTHROPIC_API_KEY=

# Safety-Glasses PPE verification (Roboflow)
PPE_MODEL_PROVIDER=             # blank=auto | roboflow_workflow | roboflow | mock
ROBOFLOW_API_KEY=              # private key (server-side only)
# Roboflow Workflow (preferred — detects objects + safety glasses)
ROBOFLOW_WORKSPACE=            # e.g. your-workspace
ROBOFLOW_WORKFLOW_ID=          # e.g. find-object-and-safety-glasses
ROBOFLOW_API_URL=https://serverless.roboflow.com
# Single detect-model fallback (optional)
ROBOFLOW_PPE_MODEL_ID=         # e.g. ppe-detection/3
ROBOFLOW_DETECT_URL=https://detect.roboflow.com
ROBOFLOW_PUBLISHABLE_KEY=      # publishable key (safe for browser/client use)
PPE_MIN_CONFIDENCE=0.72
PPE_CHECK_EXPIRATION_SECONDS=20
PPE_REQUIRED=false              # true = block work-order start until verified
