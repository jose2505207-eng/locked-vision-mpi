# =============================================================================
# Locked Vision MPI — SPONSOR STACK (shadow mode) example env.
# Copy the lines you need into your real .env. EVERYTHING here is OPTIONAL.
# With every flag false (the default), the demo runs exactly as before.
#
# Master kill-switch: ENABLE_SPONSOR_STACK=false disables ALL sponsor features
# regardless of the individual flags below.
# =============================================================================

# --- Feature flags (all default false) ---------------------------------------
ENABLE_SPONSOR_STACK=false
ENABLE_SENTRY=false
ENABLE_REDIS_EVENTS=false
ENABLE_ORKES_SHADOW=false
ENABLE_CLAUDE_ASSIST=false
ENABLE_ARIZE_LOGGING=false
ENABLE_DEEPGRAM_VOICE=false
ENABLE_RUNPOD_DETECTOR=false

# --- Redis (live event bus; NOT the authoritative store) ---------------------
REDIS_URL=redis://localhost:6379/0

# --- Sentry (error monitoring; backend + frontend) ---------------------------
SENTRY_DSN=
# Frontend (Vite) — same DSN exposed to the browser build:
VITE_SENTRY_DSN=
VITE_ENABLE_SENTRY=false

# --- Anthropic Claude (operator instructions + audit summaries) --------------
ANTHROPIC_API_KEY=
# Optional model override (defaults to a current Claude model in code):
ANTHROPIC_MODEL=claude-opus-4-8

# --- Arize (detection observability / drift) ---------------------------------
ARIZE_SPACE_KEY=
ARIZE_API_KEY=
ARIZE_MODEL_ID=locked-vision-mpi
ARIZE_MODEL_VERSION=v1

# --- Orkes Conductor (shadow workflow mirror) --------------------------------
ORKES_SERVER_URL=
ORKES_KEY_ID=
ORKES_KEY_SECRET=

# --- Deepgram (optional voice commands) --------------------------------------
DEEPGRAM_API_KEY=

# --- RunPod (optional GPU YOLO detector fallback) ----------------------------
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# --- Frontend flag so the sponsor panel can hint expected state --------------
VITE_ENABLE_SPONSOR_PANEL=true
